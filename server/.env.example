NODE_ENV=development
PORT=4000

# Exact comma-separated browser origins. Requests without an Origin header,
# including the Next.js proxy and native clients, are allowed.
ALLOWED_ORIGINS=http://localhost:3000
VERCEL_PROJECT_SLUG=
VERCEL_TEAM_SLUG=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_habit
DATABASE_POOL_SIZE=10
# Set to "require" only when the PostgreSQL provider requires TLS.
DATABASE_SSL=

REDIS_URL=redis://localhost:6379
RESEND_API_KEY=
EMAIL_FROM=Bloom Habits <reminders@example.com>
SITE_URL=http://localhost:3000
# HMAC key for six-digit email verification codes. Use at least 32 random bytes
# in production and keep it stable across API deployments.
AUTH_OTP_SECRET=replace-with-at-least-32-random-characters
# Base64-encoded Firebase service-account JSON. Worker only; never expose it
# through NEXT_PUBLIC_* variables or commit a real value.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
FIREBASE_STORAGE_BUCKET=
SENTRY_DSN=
