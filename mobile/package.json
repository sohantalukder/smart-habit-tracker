{
  "name": "bloom-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Bloom offline-first smart habit tracker for iOS and Android",
  "author": "Sohan Talukder",
  "license": "MIT",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "android:release": "react-native run-android --mode=release",
    "ios:release": "react-native run-ios --mode=Release",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:android:bundle": "cd android && ./gradlew bundleRelease",
    "build:ios": "cd ios && xcodebuild -workspace Bloom.xcworkspace -scheme Bloom -configuration Release -destination generic/platform=iOS -archivePath Bloom.xcarchive archive",
    "start": "react-native start",
    "test": "jest --no-watchman",
    "lint:rules": "eslint . --cache",
    "lint:code-format": "prettier --check \"{src,__mocks__}/**/*.{js,json,md,ts,tsx,yml,yaml}\"",
    "lint:type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "api:generate": "openapi-typescript openapi/openapi.json -o src/api/generated.ts && prettier --write src/api/generated.ts",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "fonts:sync": "node scripts/sync-font-assets.mjs && react-native-asset",
    "lint": "npm run lint:rules && npm run lint:code-format && npm run lint:type-check",
    "lint:fix": "npm run lint:rules -- --fix && npm run lint:code-format -- --write && npm run lint:type-check",
    "test:report": "jest --collectCoverage --coverageDirectory=\"./coverage\" --ci --reporters=default --reporters=jest-junit --coverage",
    "pod-install": "npx pod-install",
    "prepare": "husky"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "^8.6.3",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@op-engineering/op-sqlite": "17.1.2",
    "@react-native-clipboard/clipboard": "^1.15.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/geolocation": "3.4.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-firebase/app": "25.1.0",
    "@react-native-firebase/messaging": "25.1.0",
    "@react-native/new-app-screen": "0.80.1",
    "@react-navigation/bottom-tabs": "7.18.14",
    "@react-navigation/native": "7.3.14",
    "@react-navigation/stack": "7.10.5",
    "@shopify/flash-list": "^1.8.3",
    "@sohantalukder/rn-kit": "0.1.0",
    "@tanstack/react-query": "^5.81.5",
    "adhan": "4.4.4",
    "axios": "^1.18.1",
    "i18next": "^25.3.0",
    "react": "19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-i18next": "^15.5.3",
    "react-native": "0.80.1",
    "react-native-background-fetch": "4.4.2",
    "react-native-device-info": "14.0.4",
    "react-native-fs": "2.20.0",
    "react-native-gesture-handler": "^2.27.1",
    "react-native-get-random-values": "1.11.0",
    "react-native-html-to-pdf": "1.3.0",
    "react-native-image-crop-picker": "0.51.1",
    "react-native-keychain": "10.0.0",
    "react-native-mmkv": "^3.3.0",
    "react-native-pager-view": "^6.4.1",
    "react-native-permissions": "5.4.2",
    "react-native-reanimated": "^3.18.0",
    "react-native-safe-area-context": "^5.5.1",
    "react-native-screens": "4.11.1",
    "react-native-share": "12.3.1",
    "react-native-svg": "^15.12.0",
    "react-native-webview": "^13.15.0",
    "uuid": "^11.1.1",
    "zod": "^3.25.67",
    "zustand": "5.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/eslint-parser": "^7.25.3",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.0",
    "@react-native-community/cli-platform-android": "15.0.0",
    "@react-native-community/cli-platform-ios": "15.0.0",
    "@react-native/babel-preset": "0.80.1",
    "@react-native/eslint-config": "0.80.1",
    "@react-native/metro-config": "0.80.1",
    "@react-native/typescript-config": "0.80.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.0",
    "@types/react-native": "^0.73.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "babel-plugin-inline-dotenv": "^1.7.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-plugin-root-import": "^6.6.0",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^4.0.0",
    "eslint-plugin-testing-library": "^7.2.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^16.0.0",
    "openapi-typescript": "7.9.1",
    "prettier": "^3.4.2",
    "react-native-asset": "^2.3.0",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "19.1.0",
    "sharp": "^0.34.3",
    "typescript": "5.9.3"
  },
  "op-sqlite": {
    "sqlcipher": true,
    "performanceMode": true
  },
  "engines": {
    "node": ">=18"
  }
}
